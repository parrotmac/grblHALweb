{
  "name": "@parrotmac/grblhal-web",
  "version": "0.1.0",
  "description": "grblHAL CNC firmware compiled to WebAssembly with a simulated machine, for browsers, Web Workers and Node",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "firmware/*.mjs",
    "firmware/*.wasm",
    "firmware/build-info.json",
    "COPYING",
    "README.md"
  ],
  "scripts": {
    "prepack": "node scripts/prepack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parrotmac/grblHALweb.git",
    "directory": "pkg"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": ["grbl", "grblhal", "cnc", "gcode", "simulator", "webassembly"]
}
